[meta]
version = 1
name = "Graphite"
description = "Graphite"
variant = "dark"
inherits = "vicinae-dark"

# Every colour is opaque, because vicinae draws the 8-digit and { opacity }
# forms as solid. So graphite's translucent tokens (line, sel, hover) are
# flattened over the ground: palette.toml's [palette.dark.flat].

[colors.core]
background = "{{ .palette.dark.ground }}"
foreground = "{{ .palette.dark.text }}"
secondary_background = "{{ .palette.dark.raised }}"
border = "{{ .palette.dark.flat.line }}"
# No brand accent: vicinae's leftover accent uses take the text tone, the way
# graphite's selected day or chip inverts text and ground.
accent = "{{ .palette.dark.text }}"
accent_foreground = "{{ .palette.dark.ground }}"

# Graphite's warm and hot fill the slots they match; the rest keep the
# terminal ANSI hues, which are the only other hues on this desktop.
[colors.accents]
blue = "#8fb0d9"
green = "#b5c98f"
magenta = "#cba6c9"
orange = "{{ .palette.dark.warm }}"
purple = "#ddc0db"
red = "{{ .palette.dark.hot }}"
yellow = "{{ .palette.dark.warm }}"
cyan = "#88c0c8"

[colors.main_window]
border = "colors.core.border"
footer = { background = "colors.core.secondary_background" }

[colors.shortcut]
border = "colors.core.border"

[colors.text]
default = "colors.core.foreground"
muted = "{{ .palette.dark.dim }}"
placeholder = "{{ .palette.dark.dim }}"
danger = "{{ .palette.dark.hot }}"
success = "#b5c98f"
selection = { background = "{{ .palette.dark.text }}", foreground = "{{ .palette.dark.ground }}" }

# Focus is graphite's one non-status colour.
[colors.input]
border = "colors.core.border"
border_focus = "{{ .palette.dark.warm }}"
border_error = "{{ .palette.dark.hot }}"

[colors.button.primary]
background = "colors.core.secondary_background"
foreground = "colors.core.foreground"
hover = { background = "{{ .palette.dark.flat.hoverRaised }}" }
focus = { outline = "{{ .palette.dark.warm }}" }

[colors.list.item.hover]
background = "{{ .palette.dark.flat.hover }}"
foreground = "{{ .palette.dark.text }}"
secondary_foreground = "{{ .palette.dark.dim }}"

[colors.list.item.selection]
background = "{{ .palette.dark.flat.sel }}"
foreground = "{{ .palette.dark.bright }}"
secondary_background = "{{ .palette.dark.flat.sel }}"
secondary_foreground = "{{ .palette.dark.dim }}"

[colors.grid.item]
background = "colors.core.secondary_background"
hover = { outline = "{{ .palette.dark.flat.line }}" }
selection = { outline = "{{ .palette.dark.dim }}" }

[colors.scrollbars]
background = "{{ .palette.dark.rule }}"

[colors.loading]
bar = "{{ .palette.dark.dim }}"
spinner = "{{ .palette.dark.text }}"
