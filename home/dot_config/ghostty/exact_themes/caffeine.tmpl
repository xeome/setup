# Caffeine — https://github.com/crynta/terax-ai src/modules/theme/themes/caffeine.ts
#
# Managed by chezmoi: edit dot_config/ghostty/exact_themes/caffeine.tmpl
#
# Colours only, like ghostty's built-in themes; everything else stays in the
# config. The hues mirror ~/.config/alacritty/caffeine.toml and
# ~/.config/foot/foot.ini, so a change here wants the same change there.

# Slot 0 is `rule`, not a true black, because the background is already
# near-black.
palette = 0={{ .palette.dark.rule }}
palette = 1=#e06c75
palette = 2=#b5c98f
palette = 3=#ffd9a0
palette = 4=#8fb0d9
palette = 5=#cba6c9
palette = 6=#88c0c8
palette = 7={{ .palette.dark.text }}
palette = 8={{ .palette.dark.dim }}
palette = 9=#ff8a93
palette = 10=#c9dba8
palette = 11=#ffe6c4
palette = 12=#a9c3e0
palette = 13=#ddc0db
palette = 14=#a4d4da
palette = 15={{ .palette.dark.bright }}

background = {{ .palette.dark.panel }}
foreground = {{ .palette.dark.text }}

# A bright block with the panel showing through the glyph.
cursor-color = {{ .palette.dark.bright }}
cursor-text = {{ .palette.dark.panel }}

# Selected text is inverted, text on ground, as vicinae selects it: a `sel`
# wash is too faint to show a range in a terminal.
selection-background = {{ .palette.dark.text }}
selection-foreground = {{ .palette.dark.ground }}
