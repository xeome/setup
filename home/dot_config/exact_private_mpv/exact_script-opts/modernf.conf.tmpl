# Layout (reduced/original/mid)
layout=reduced

boxalpha=140
seekbarfg_color="{{ upper (trimPrefix "#" .palette.dark.text) }}"
seekbarbg_color="{{ trimPrefix "#" .palette.dark.rule }}"
seekrange=yes
seekrangealpha=100

showonpause=yes
timetotal=no
timems=no
visibility=auto
hidetimeout=2000
fadeduration=150
deadzone=150

volumecontrol=yes
windowcontrols=auto
scalewindowed=1
scalefullscreen=1
language=eng

vidscale=no
