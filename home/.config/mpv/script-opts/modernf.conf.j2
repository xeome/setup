# Layout (reduced/original/mid)
layout=reduced

boxalpha=140
seekbarfg_color="{{ palette.dark.text[1:] | upper }}"
seekbarbg_color="{{ palette.dark.rule[1:] }}"
seekrange=yes
seekrangealpha=100

showonpause=yes
timetotal=no
timems=no
visibility=auto
hidetimeout=2000
fadeduration=150
deadzone=150

volumecontrol=yes
windowcontrols=auto
scalewindowed=1
scalefullscreen=1
language=eng

vidscale=no
