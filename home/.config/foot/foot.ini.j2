# Caffeine — https://github.com/crynta/terax-ai src/modules/theme/themes/caffeine.ts
#
# The hues are TERMINAL in infra/data.py, which ghostty's caffeine themes and
# alacritty's caffeine.toml read too.

[main]
font=JetBrainsMono Nerd Font:style=Medium:size=10
font-bold=JetBrainsMono Nerd Font:style=Bold:size=10
font-italic=JetBrainsMono Nerd Font:style=Medium Italic:size=10
font-bold-italic=JetBrainsMono Nerd Font:style=Bold Italic:size=10
pad=15x15
term=xterm-256color

# foot cannot follow the desktop colour scheme, so theme-toggle sends it
# SIGUSR1 for [colors-dark] and SIGUSR2 for [colors-light]. foot rejects stale
# keys and sections, so run `foot --check-config` after editing.
initial-color-theme=dark

[colors-dark]
# Opaque, so contrast does not depend on what is behind the window.
alpha=1.0

background={{ palette.dark.panel[1:] }}
foreground={{ palette.dark.text[1:] }}

# A bright block with the panel showing through the glyph. foot takes `text bg`.
cursor={{ palette.dark.panel[1:] }} {{ palette.dark.bright[1:] }}

# Selected text is inverted, text on ground, as vicinae selects it: a `sel`
# wash is too faint to show a range in a terminal.
selection-foreground={{ palette.dark.ground[1:] }}
selection-background={{ palette.dark.text[1:] }}

# regular0 is `rule`, not a true black, because the background is already
# near-black.
{%- for c in term.dark.normal.values() %}
regular{{ loop.index0 }}={{ c[1:] }}
{%- endfor %}
{%- for c in term.dark.bright.values() %}
bright{{ loop.index0 }}={{ c[1:] }}
{%- endfor %}

[colors-light]
alpha=1.0

background={{ term.light.background[1:] }}
foreground={{ term.light.foreground[1:] }}

cursor={{ term.light.cursorText[1:] }} {{ term.light.cursor[1:] }}

selection-foreground={{ term.light.foreground[1:] }}
selection-background={{ term.light.selection[1:] }}

{% for c in term.light.normal.values() -%}
regular{{ loop.index0 }}={{ c[1:] }}
{% endfor -%}
{% for c in term.light.bright.values() -%}
bright{{ loop.index0 }}={{ c[1:] }}
{% endfor %}
[cursor]
style=block

[mouse]
hide-when-typing=yes

[key-bindings]
font-increase=Control+Shift+plus
font-decrease=Control+Shift+underscore
font-reset=Control+0
